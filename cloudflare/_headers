# Cloudflare Pages only (copied into the upload by .github/workflows/cloudflare-pages.yml).
# Keep the *.pages.dev copies of the site out of search results; stationerydropwatch.com is the only indexed host.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# HSTS covers subdomains (checked Nov 25, 2026: www redirects to the apex over HTTPS, media is an R2 custom domain that
# serves HTTPS; every other name is a DNS-only mail record). Not on the preload list: that is hard to undo and needs the owner's yes.
# Security headers for the live site. Cloudflare Pages already sends X-Content-Type-Options: nosniff and
# Referrer-Policy: strict-origin-when-cross-origin (checked live Nov 22, 2026), so they are not repeated here.
# Pages Functions (including /api/subscribe) do not receive these headers. That fallback page uses an inline <style>,
# which this report-only policy would flag; leave the function response alone.
# CSP is report-only. Origins below are the ones pages, site/assets/app.js, and site/assets/style.css actually load,
# plus Cloudflare's edge-injected Web Analytics beacon:
# same-origin documents, styles, fonts, images, and the signup fetch, Turnstile's script and challenge frame
# (https://challenges.cloudflare.com), and https://static.cloudflareinsights.com for beacon.min.js.
# The injected script URL is versioned (beacon.min.js/v…), so script-src allows that host, not only one file path.
# Automatic injection POSTs to this site at /cdn-cgi/rum, which connect-src 'self' already allows.
# https://cloudflareinsights.com is only the manual-snippet reporting host (Cloudflare Web Analytics FAQ), so it is not added.
# style-src-attr allows the three format-icon custom properties (--iw/--ih) on the comparison SVGs. style-src stays
# 'self', so a <style> block on an HTML page is still reported. script-src hashes the filter forms' onsubmit="return false"
# (sha256 of that source, with 'unsafe-hashes') so those pages do not report an inline-handler violation.
# Pages keeps one rule per URL pattern: a second "/*" block replaces the first one (seen live Nov 25, 2026, when a
# trailing "/*" detach block dropped HSTS, X-Frame-Options, Permissions-Policy and the CSP). So the CORS detach lives in
# this block. Pages sends Access-Control-Allow-Origin: * on every static file by default; nothing on or off the site needs
# it (our pages fetch only same-origin files; Relay, the checker and the alert routine read the site server-side).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  ! Access-Control-Allow-Origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com 'unsafe-hashes' 'sha256-GZIcz60Uwd6wT3vaYke/atSr53TehbYAPepOa3d03Vw='; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Cache. HTML stays on Pages' default (public, max-age=0, must-revalidate), which is right for a page that changes every
# ~30 minutes. The stylesheet and scripts are linked as ?v=<content hash>, so each URL never changes and can be cached for a year.
# Other assets keep stable file names, so one day. (Pages default for them today is 4 hours.)
/assets/style.css
  Cache-Control: public, max-age=31536000, immutable
# Pages serves .js as "application/javascript" with no charset (checked live Nov 25, 2026), so a browser tab that opens
# the file on its own may guess the wrong encoding. Pages lets _headers override its default Content-Type.
/assets/app.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8
/assets/local-time.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8
# Font files keep stable names (not content-hashed), so cache them for 30 days and do not mark them immutable.
# data/search-index.json stays on Pages' default, same as HTML and data/stock.json. The index is rebuilt
# with the site about every 30 minutes, so it must not get this 30-day font cache.
/assets/fonts/*
  Cache-Control: public, max-age=2592000
/assets/brand/*
  Cache-Control: public, max-age=86400
/assets/badges/*
  Cache-Control: public, max-age=86400
/assets/books/*
  Cache-Control: public, max-age=86400
/assets/shop/*
  Cache-Control: public, max-age=86400
